{
  // markdownlint-cli2 configuration
  "config": {
    "default": true,
    // 行の長さ制限は無効（長い表やURL等が多い）
    "MD013": false,
    // インラインHTML許可（バッジ等）
    "MD033": false,
    // 最初の行が見出しでなくてもOK（frontmatter）
    "MD041": false,
    // 重複見出し許可（異なるセクションで同名見出しあり）
    "MD024": { "siblings_only": true },
    // コードブロック内の行の長さチェック無効
    "MD046": { "style": "fenced" },
    // 見出しスタイル統一は無効（frontmatter内の見出しが誤検出される）
    "MD003": false,
    // テーブルパイプスタイル統一は無効（コンパクト形式を許容）
    "MD060": false,
    // コードブロック言語指定は無効（疑似コード・混合コードブロックが多い）
    "MD040": false,
    // 見出し前後の空行は無効（YAML frontmatter直後の見出しで誤検出）
    "MD022": false,
    // リスト前後の空行は無効（既存スタイルとの整合性）
    "MD032": false,
    // 見出し末尾の句読点は無効（日本語の「。」が誤検出される）
    "MD026": false,
    // 強調の見出し代用は無効（ADR の選択肢表記で使用）
    "MD036": false,
    // 末尾スペースは無効（テンプレート内のプレースホルダ）
    "MD009": false,
    // 連続空行は無効（セクション区切りで使用）
    "MD012": false,
    // 番号付きリストのプレフィックスは無効（既存スタイル）
    "MD029": false,
    // 見出しレベルの連続性は無効（参照ドキュメントで h3 から始まる場合あり）
    "MD001": false,
    // コードブロック前後の空行は無効（リスト内コードブロック等で既存スタイルと衝突）
    "MD031": false,
    // 強調記法スタイルは無効（** と __ の混在を許容）
    "MD050": false
  },
  // YAML frontmatter付きファイルは先頭---を許容
  "frontMatter": "^---\\s*$[\\s\\S]*?^---\\s*$",
  // チェック対象
  "globs": [
    ".github/**/*.md",
    "docs/**/*.md",
    "*.md"
  ],
  // 除外
  "ignores": [
    ".worktrees/**",
    "node_modules/**",
    ".copilot/**"
  ]
}
