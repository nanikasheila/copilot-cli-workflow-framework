{
  // markdownlint-cli2 configuration
  "config": {
    "default": true,
    // 行の長さ制限は無効（長い表やURL等が多い）
    "MD013": false,
    // インラインHTML許可（バッジ等）
    "MD033": false,
    // 最初の行が見出しでなくてもOK（frontmatter付きファイル）
    "MD041": false,
    // 重複見出し許可（異なるセクションで同名見出しあり: Bad/Good ペア等）
    "MD024": { "siblings_only": true },
    // コードブロックスタイル統一
    "MD046": { "style": "fenced" },
    // 見出しスタイル: atx のみ（frontmatter の --- が setext に誤検出されるため無効化）
    "MD003": false,
    // テーブルパイプスタイル: コンパクト形式を許容
    "MD060": false,
    // 見出しレベルの連続性: agent/skill の .md は h3 から始まる設計のため無効化
    "MD001": false
  },
  // チェック対象
  "globs": [
    ".github/**/*.md",
    "docs/**/*.md",
    "*.md"
  ],
  // 除外
  "ignores": [
    ".worktrees/**",
    "node_modules/**",
    ".copilot/**"
  ]
}
